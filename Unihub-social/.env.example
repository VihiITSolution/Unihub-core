# Server Configuration
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# Database Configuration - SAME database as Unihub-backend (shared schema)
DB_HOST=206.189.133.69
DB_PORT=3306
DB_USER=unihub_user
DB_PASSWORD=
DB_NAME=unihub

# JWT Configuration - MUST match Unihub-backend's JWT_SECRET exactly,
# tokens are verified locally here without calling Unihub-backend.
JWT_SECRET=

# CORS Configuration (comma-separated, same allow-list as Unihub-backend)
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DO_HOST=

# File storage. Files are written here and must be served by Unihub-backend's
# /uploads static route, so this needs to resolve to the SAME physical folder
# Unihub-backend serves from.
#   - Local dev: this service lives at Unihub-core/Unihub-social, a sibling
#     of Unihub-backend one level up - hence the two "../".
#   - Docker/production: both containers mount the same named volume, e.g. at
#     /app/uploads in both, and this should just be "/app/uploads".
UPLOADS_DIR=../../Unihub-backend/uploads

# Base URL where Unihub-backend serves /uploads from (used to build absolute
# URLs returned to the frontend, e.g. https://unihub.lk or http://localhost:5000)
UPLOADS_PUBLIC_BASE_URL=http://localhost:5000
